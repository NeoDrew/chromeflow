# Dependencies
node_modules/

# Build output (extension dist/, website dist/, etc.)
dist/

# pack.mjs output (packages/extension/chromeflow-X.Y.Z.zip) — reproducible,
# manually uploaded to the Chrome Web Store dev console, not source.
*.zip

# Env / secrets
.env
.env.*
!.env.example

# Local scratch and working notes — never shipped, never committed.
# Bug write-ups (ISSUE-*.md) are cited by bare filename in code comments as
# motivating evidence for fixes (see CLAUDE.md's "Fix philosophy"), but the
# files themselves are local-only; they may live at repo root or under
# issues/ (any depth — this pattern matches both).
ISSUE-*.md

# Personal/sensitive working notes — DataAnnotation-style task backlogs,
# hint-usefulness audits, the anti-bot-detection log, etc. Never reference
# paid annotation platforms or detection-evasion specifics anywhere outside
# this ignored directory.
.private/

# Session-scratch files from social-posting workflows
.reddit*

# macOS Finder metadata
.DS_Store

# Editor/IDE
.vscode/
.idea/

# Vercel CLI link state (per-directory, regenerated by `vercel link`)
.vercel
