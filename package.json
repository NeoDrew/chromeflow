{
  "name": "chromeflow",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "express-rate-limit": "^8.2.2"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:mcp": "npm run dev -w packages/mcp-server",
    "dev:ext": "npm run dev -w packages/extension",
    "dev:web": "npm run dev --prefix apps/website",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
